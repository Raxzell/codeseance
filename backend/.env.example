# ==============================================================================
# CodeSéance Backend Environment Configuration
# ==============================================================================
# NOTE: Zero API keys are required to run CodeSéance!
# If neither GROQ_API_KEY nor OPENAI_API_KEY is set, POST /api/seance/ask
# automatically runs in deterministic BM25 extractive citation mode
# (`mode: "extractive"`), and all 3 demo presets run 100% offline.

# Optional: Groq API (checked first when present)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: OpenAI API (used if GROQ_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: GitHub Personal Access Token to raise GitHub REST API fallback limits
GITHUB_TOKEN=

# Optional: Comma-separated frontend origins allowed via CORS (in addition to localhost & *.vercel.app)
FRONTEND_ORIGINS=http://localhost:5173
