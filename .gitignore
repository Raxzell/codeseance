# Keep Kiro steering, specs, and hooks tracked in Git for Kiroween 2026
!.kiro/
!.kiro/**

# Environment variables & secrets (keep templates tracked)
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Python bytecode, caches, and virtual environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Node / Frontend dependencies & build artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS, IDE, and temporary artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.tmp
temp_repos/
